{
  "name": "ahmed-smart-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate": "npx ts-node ./scripts/generate.ts",
    "start": "next start",
    "lint": "eslint src scripts tests next.config.mjs",
    "vercel-build": "next build",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src utils scripts tests *.mjs *.js *.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src utils scripts tests *.mjs *.js *.ts *.json .github/workflows/*.yml",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "audit:production": "npm audit --omit=dev"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.2",
    "@langchain/openai": "^1.8.0",
    "@langchain/textsplitters": "^1.0.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.503.0",
    "next": "16.4.3",
    "next-themes": "^0.2.1",
    "postcss": "^8.5.32",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "three": "^0.170.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@react-three/test-renderer": "^9.1.1",
