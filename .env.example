# Optional knowledge service. The farm, blog and catalog need no API keys.
# Copy to .env.local; never commit real credentials.
SUPABASE_URL=https://your-project-ref.supabase.co
# A publishable key is preferred; legacy SUPABASE_ANON_KEY remains supported.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
OPENAI_API_KEY=your-provider-key

# Needed ONLY for the explicit, database-writing `npm run generate` command.
# Server-only secret key; legacy SUPABASE_SERVICE_ROLE_KEY is also supported.
# SUPABASE_SECRET_KEY=your-server-only-secret-key
